APP_NAME=GyanQuest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Prefer MySQL for shared team setups; SQLite works for a quick local smoke test.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gyanquest
DB_USERNAME=root
DB_PASSWORD=

# Local fallback (uncomment and set DB_CONNECTION=sqlite):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

ADMIN_NAME=GyanQuest Admin
ADMIN_EMAIL=admin@gyanquest.local
ADMIN_PASSWORD=ChangeMeNow!123

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5500,127.0.0.1,127.0.0.1:5500,127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5500
